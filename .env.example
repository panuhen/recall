# ── Database ────────────────────────────────────────────────
POSTGRES_USER=recall
POSTGRES_PASSWORD=recall
POSTGRES_DB=recall
# Inside the compose network use host `postgres` port 5432.
# From the host, Postgres is published on 54324 (see docker-compose.yml).
DATABASE_URL=postgresql://recall:recall@postgres:5432/recall

# ── Backend (FastMCP) ───────────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8765
# Host allowlist for MCP DNS-rebinding protection. Add the public MCP FQDN in prod,
# e.g. append ,recall-mcp.example.com
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*,backend,backend:*

# ── Auth ────────────────────────────────────────────────────
# AUTH_MODE=dev bypasses sign-in and injects a fixed dev user (LOCAL ONLY).
# AUTH_MODE=entra requires real Entra JWT validation (tid pinned below).
# AUTH_MODE=betterauth uses Google sign-in via Better Auth (block below).
AUTH_MODE=dev
DEV_USER_UPN=dev@example.com
DEV_USER_NAME=Dev User
DEV_USER_OID=00000000-0000-0000-0000-000000000001

# Entra app registration — used when AUTH_MODE=entra. Create a single-tenant app
# registration in your Entra tenant and fill these in (see infra/README.md).
AZURE_TENANT_ID=<your-entra-tenant-id>
AZURE_CLIENT_ID=<your-app-client-id>
AZURE_CLIENT_SECRET=
AZURE_API_AUDIENCE=api://<your-app-client-id>
AUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Secret for signing the BFF session cookie. Generate: openssl rand -base64 32
SESSION_SECRET=
# Optional: return here after Entra logout. Must be registered on the app as a
# post-logout redirect URI, else Entra shows its own signed-out page.
# AUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:3000

# Better Auth — used when AUTH_MODE=betterauth. The web app signs users in with
# Google and is the OAuth 2.1 authorization server for /mcp (clients self-register);
# the backend validates its tokens. Two public hosts: the web app (BETTER_AUTH_URL)
# and the MCP endpoint (MCP_PUBLIC_URL). The web app needs DATABASE_URL and creates
# its own ba_* tables in recall's database at startup.
# Public web origin = OAuth issuer, kept verbatim: no trailing slash.
# BETTER_AUTH_URL=https://recall.example.com
# Generate: openssl rand -base64 32. The web app refuses to start on an https
# origin with this empty or left at the dev placeholder.
# BETTER_AUTH_SECRET=
# Where the backend reaches the web app to validate MCP tokens. Compose sets
# http://web:3000 for the backend; defaults to BETTER_AUTH_URL.
# BETTER_AUTH_INTERNAL_URL=http://web:3000
# Google OAuth client (type "Web application"). Authorized redirect URI to register:
#   {BETTER_AUTH_URL}/api/auth/callback/google
#   e.g. https://recall.example.com/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Who may sign in. open (default): any Google account. closed: only
# BETTER_AUTH_ALLOWED_EMAILS (comma-separated addresses or @domain suffixes).
# Checked on every sign-in, web request and MCP token, so removing an address
# and restarting locks that person out. closed with an empty list refuses to
# start. (BETTER_AUTH_SIGNUP is the old name and still works.)
# BETTER_AUTH_ACCESS=closed
# BETTER_AUTH_ALLOWED_EMAILS=you@example.com,@example.org
# For betterauth, also set MCP_PUBLIC_URL=https://recall-mcp.example.com (below) and add
# recall-mcp.example.com to MCP_ALLOWED_HOSTS (above).

# ── MCP OAuth (AI assistants → /mcp) ────────────────────────
# When AUTH_MODE=entra, /mcp uses FastMCP's AzureProvider: MCP clients (Claude,
# Copilot) get a browser consent flow against the app above — no PATs. Needs the
# client secret set, the redirect URI  {MCP_PUBLIC_URL}/auth/callback  added to
# the app registration, and (ideally) an exposed API scope in MCP_SCOPES.
# Left unset / AUTH_MODE=dev → /mcp is open locally and serves the dev user.
#
# OAuth proxy state (client registrations, transactions, tokens) is stored
# encrypted in Postgres (mcp_oauth_kv), keyed off AZURE_CLIENT_SECRET — so the
# connect flow works across replicas and survives deploys. Rotating the client
# secret invalidates that state; connected clients just re-consent (a browser
# round-trip), nothing breaks. No extra configuration needed.
#
# Public base URL the MCP endpoint is reached at (scheme+host, no trailing /).
# Dev: the host-published backend port. Prod: the public MCP FQDN, e.g.
# https://recall-mcp.example.com. Used in both entra and betterauth mode.
MCP_PUBLIC_URL=http://localhost:8004
# Unprefixed names of API scopes THIS app exposes (comma-separated). FastMCP
# prefixes each with the app's identifier URI → api://<client-id>/<scope>, so
# the token's audience is our own API. Must match an exposed scope on the
# registration. Empty → "access". (NOT Graph scopes like User.Read — those get
# prefixed too and would 404 as AADSTS65005.)
MCP_SCOPES=access

# ── Embeddings ──────────────────────────────────────────────
# EMBEDDING_PROVIDER: azure (default) | openai (any OpenAI-compatible
# POST {EMBEDDING_BASE_URL}/embeddings: OpenAI, Ollama's /v1, vLLM, HF TEI, LiteLLM).
# Changing the model or EMBEDDING_DIM re-embeds every note: the backend retypes
# notes.embedding to vector(EMBEDDING_DIM) on startup (clearing all vectors) and
# the backfill re-queues every note. Restart the backend and the worker together.
EMBEDDING_PROVIDER=azure

# Vector size for every provider; must match what the model returns. 1..2000
# (pgvector's HNSW limit). AZURE_OPENAI_EMBEDDING_DIM is read as a fallback.
EMBEDDING_DIM=1536

# azure: full deployment URL; the call always sends `dimensions`. 3-large
# defaults to 3072 dims, so we request 1536 (Matryoshka).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/openai/deployments/text-embedding-3-large/embeddings?api-version=2024-02-01
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# openai: EMBEDDING_API_KEY is optional (no Authorization header when empty,
# which most self-hosted servers expect). EMBEDDING_SEND_DIMENSIONS=auto sends
# `dimensions` only for OpenAI text-embedding-3* models; true/false force it.
#
# OpenAI:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIM=1536
#
# Ollama on the compose network (add an `ollama` service, then
# `docker compose exec ollama ollama pull bge-m3`). bge-m3 is multilingual,
# Finnish included; nomic-embed-text (768 dims) is English-focused.
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=http://ollama:11434/v1
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIM=1024
# EMBEDDING_SEND_DIMENSIONS=auto

# ── Trash / retention ───────────────────────────────────────
# Deletes are soft — items go to Trash and stay restorable. Auto-purge is OFF
# by default: TRASH_RETENTION_DAYS=0 keeps trashed items until purged by hand.
# Set a positive number of days to have the worker hard-delete older items on
# the schedule below (standard 5-field cron; needs the procrastinate worker up).
TRASH_RETENTION_DAYS=0
TRASH_PURGE_CRON=0 4 * * *

# ── Web (Next.js BFF) ───────────────────────────────────────
# URL the BFF uses to reach the backend inside the compose network.
BACKEND_URL=http://backend:8765

# Public origin of the web app. The web app uses it for absolute Open Graph /
# Twitter card image URLs (falls back to AUTH_POST_LOGOUT_REDIRECT_URI, then
# localhost); the backend uses it for the shareable `url` its MCP tools return
# for notes and workspaces (falls back to BETTER_AUTH_URL; unset = no links).
# In entra mode, set it on the backend too.
# APP_URL=https://recall.example.com
