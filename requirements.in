# Direct (intent) dependencies for the recall backend, as ranges. This is the
# human-edited source of truth; the pinned + hashed lockfile `requirements.txt`
# is COMPILED from it and is what the Dockerfile installs.
#
# Recompile (from repo root, needs network):
#   uv pip compile requirements.in --generate-hashes -o requirements.txt
#
# The initial lock was seeded to the exact versions running in the container
# with `--constraint <pip-freeze>` so it matched a known-good set. To upgrade a
# dependency: edit its range here, recompile (drop the constraint to move
# forward), smoke-test the MCP + REST surface, then commit both files.

# ── MCP + ASGI core ──────────────────────────────────────────
fastmcp>=3.4,<4
mcp>=1.28,<2           # imported directly (mcp.types); also pulled by fastmcp
starlette>=1.3,<2      # imported directly (requests/responses)
# fastmcp's kv-storage lib; imported directly for the Postgres-backed MCP OAuth
# state store (src/oauth_storage.py). Pre-1.0 — any minor can break.
py-key-value-aio>=0.4,<1

